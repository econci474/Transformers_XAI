# Default: auto-detect text and normalise to LF on commit.
* text=auto eol=lf

# Source code and configs — always LF in the index and on disk
# (avoids CRLF churn when the working tree is Windows and runs on Linux CSD3).
*.py        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.csv       text eol=lf
*.tsv       text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.tex       text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows-native scripts keep CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary — never touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.npz       binary
*.npy       binary
*.parquet   binary
*.pt        binary
*.pth       binary
*.ckpt      binary
*.safetensors binary
*.pkl       binary
*.pyc       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.bed       binary
*.bim       binary
*.fam       binary
*.bcf       binary
*.vcf.gz    binary
